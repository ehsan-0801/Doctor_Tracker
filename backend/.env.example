# Server
PORT=4000
NODE_ENV=development

# Origin of the Next.js frontend (used for CORS)
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Atlas connection string (database name: doctor_tracker)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doctor_tracker?retryWrites=true&w=majority

# Initial administrator, used only by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Optional: image uploads (doctor photos). From Cloudinary → Settings → API Keys.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
